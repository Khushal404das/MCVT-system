# Copy to .env and fill in. Never commit .env (NFR-S-01).

# Shared secret between the Python engine and the PHP WebSocket hub.
# Created automatically with a random value on first start if missing.
ENGINE_TOKEN=

# SMTP account used to email journey videos (Gmail: use an App Password).
SMTP_USER=
SMTP_PASSWORD=
# Optional overrides of email.host / email.port in config.yaml
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
